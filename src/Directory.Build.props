<Project>
  <Import Project="$(MSBuildThisFileDirectory)..\Directory.Build.props" />

  <PropertyGroup>
    <AssemblyName>$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <Title>$(MSBuildProjectName)</Title>
    <Summary>$(MSBuildProjectName): Building a static website using .NET</Summary>
    <Description>This is a library that builds a static website using .NET</Description>
    <Version>1.0.0</Version>

    <Authors>Justin Yoo</Authors>
    <Company>GetScissorHands</Company>
    <Copyright>© GetScissorHands. All rights reserved.</Copyright>

    <Product>$(MSBuildProjectName)</Product>
    <Owners>justinyoo;getscissorhands</Owners>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/getscissorhands/Scissorhands.NET</RepositoryUrl>

    <PackageId>$(MSBuildProjectName)</PackageId>
    <PackageIcon>ScissorHands.png</PackageIcon>
    <PackageIconUrl>https://raw.githubusercontent.com/getscissorhands/Scissorhands.NET/refs/heads/vnext/assets/ScissorHands.png</PackageIconUrl>
    <PackageProjectUrl>https://github.com/getscissorhands/Scissorhands.NET</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\assets\ScissorHands.png" Pack="true" PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
