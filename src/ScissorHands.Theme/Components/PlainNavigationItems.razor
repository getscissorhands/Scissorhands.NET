@namespace ScissorHands.Theme.Components

@foreach (var node in Nodes)
{
    <li>
        @if (node.Url is not null)
        {
            <a href="@RequireRelativeUrl(node.Url)">@node.Title</a>
        }
        else
        {
            <span>@node.Title</span>
        }
        @if (node.Children.Count > 0)
        {
            <ul>
                <PlainNavigationItems Nodes="@node.Children" />
            </ul>
        }
    </li>
}
