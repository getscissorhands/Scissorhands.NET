<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <LangVersion>latest</LangVersion>

    <AssemblyName>ScissorHands.Web</AssemblyName>
    <RootNamespace>ScissorHands.Web</RootNamespace>

    <EnableDefaultContentItems>false</EnableDefaultContentItems>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>

    <PackageId>ScissorHands.Web</PackageId>
    <Version>1.0.0</Version>

    <Title>ScissorHands.Web</Title>
    <Authors>Justin Yoo</Authors>
    <Company>GetScissorHands</Company>
    <Product>ScissorHands.Web</Product>
    <Summary>ScissorHands.Web: Building a static website using .NET</Summary>
    <Description>This is a library that builds a static website using .NET</Description>
    <Copyright>© GetScissorHands. All rights reserved.</Copyright>
    <Owners>justinyoo</Owners>

    <PackageProjectUrl>https://github.com/getscissorhands/Scissorhands.NET</PackageProjectUrl>
    <PackageIcon>ScissorHands.png</PackageIcon>
    <PackageIconUrl>https://raw.githubusercontent.com/getscissorhands/Scissorhands.NET/refs/heads/vnext/assets/ScissorHands.png</PackageIconUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>scissorhands;web;static-site</PackageTags>

    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>

    <RepositoryUrl>https://github.com/getscissorhands/Scissorhands.NET</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\..\assets\ScissorHands.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Content Include="contents/**/*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="themes/**/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />

    <PackageReference Include="Markdig" Version="0.*" />
    <PackageReference Include="Scrutor" Version="7.*" />
    <PackageReference Include="TestableIO.System.IO.Abstractions.Wrappers" Version="22.*" />
    <PackageReference Include="System.Reactive" Version="6.*" />
    <PackageReference Include="YamlDotNet" Version="16.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ScissorHands.Core\ScissorHands.Core.csproj" />
    <ProjectReference Include="..\ScissorHands.Plugin\ScissorHands.Plugin.csproj" />
    <ProjectReference Include="..\ScissorHands.Theme\ScissorHands.Theme.csproj" />
  </ItemGroup>

</Project>
