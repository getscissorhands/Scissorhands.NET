@inherits ScissorHands.Theme.NotFoundViewBase
@layout MainLayout

<section class="not-found prose">
    <a class="back-link" href=".">&larr; Back home</a>
    @if (string.IsNullOrWhiteSpace(Document?.Html) == true)
    {
        <article>
            <p class="error-code">404</p>
            <h1>Page not found</h1>
            <p>The page you are looking for does not exist.</p>
        </article>
    }
    else
    {
        <article>
            @((MarkupString)Document.Html)
        </article>
    }
</section>
