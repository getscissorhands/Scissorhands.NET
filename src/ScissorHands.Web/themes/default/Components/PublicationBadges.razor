@namespace ScissorHands.Web
@using System.Globalization
@inherits PublicationBadgeBase

@if (Badges.Count > 0)
{
    <span class="publication-badges">
        @foreach (var badge in Badges)
        {
            var label = badge.ScheduledDate is { } date
                ? $"Scheduled on {date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)}"
                : "Draft";
            <span class="publication-badge" @attributes="badge.Attributes">@badge.RenderContent(label)</span>
        }
    </span>
}
