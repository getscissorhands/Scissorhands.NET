@namespace ScissorHands.Web
@inherits LanguageSwitcherBase

@if (Links.Count > 1)
{
    <div class="@($"language-switcher {Class}".TrimEnd())">
        <button class="language-switcher-toggle" type="button" aria-expanded="false" aria-controls="language-switcher-list" hidden>
            @AriaLabel
            <span class="navigation-icon" aria-hidden="true"></span>
        </button>
        <ul id="language-switcher-list" class="language-switcher-list" aria-label="@AriaLabel">
            @foreach (var link in Links)
            {
                <li>
                    @* Explicit tabindex preserves link tabbing across WebKit keyboard modes. *@
                    <a href="@link.Url" lang="@link.Locale" hreflang="@link.Locale" tabindex="0" aria-current="@(link.IsCurrent ? "true" : null)">@link.Label</a>
                </li>
            }
        </ul>
    </div>
}
