@inherits ScissorHands.Theme.PageViewBase
@layout MainLayout

<section class="page">
    <article class="prose">
        @((MarkupString)Document?.Html!)

        @if (Document?.Metadata.Tags.Any() == true)
        {
            <ul class="tag-list" aria-label="Page tags">
                @foreach (var tag in Document.Metadata.Tags)
                {
                    <li><a href="@GetTagUrl(tag)">#@tag</a></li>
                }
            </ul>
        }
    </article>

    @if (PageNavigation?.Previous is not null || PageNavigation?.Next is not null)
    {
        <nav class="page-navigation" aria-label="Page navigation">
            @* Explicit tabindex preserves link tabbing across WebKit keyboard modes. *@
            @if (PageNavigation?.Previous is { } previous)
            {
                <a class="page-navigation-previous" href="@previous.Url" rel="prev" tabindex="0">
                    <span class="page-navigation-direction">Previous</span>
                    <span>@previous.Title</span>
                </a>
            }
            @if (PageNavigation?.Next is { } next)
            {
                <a class="page-navigation-next" href="@next.Url" rel="next" tabindex="0">
                    <span class="page-navigation-direction">Next</span>
                    <span>@next.Title</span>
                </a>
            }
        </nav>
    }
</section>
