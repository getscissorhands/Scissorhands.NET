@using System.Globalization
@inherits ScissorHands.Theme.MainLayoutBase

<CascadingMainLayoutBase Documents="@Documents" TaggedDocuments="@TaggedDocuments" Tag="@Tag" TaggedPosts="@TaggedPosts" TaggedPages="@TaggedPages" Document="@Document" Plugins="@Plugins" Theme="@Theme" Site="@Site">
    <!DOCTYPE html>
    <html lang="@PageLocale">
    <head>
        <base href="@Site!.BaseUrl" />

        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content="@Site.Generator" />
        <meta name="theme-color" content="#fffcf5" />
        <link rel="icon" type="image/x-icon" href="@GetThemeUrl("favicon.ico")" />

        <title>@PageTitle</title>
        <meta name="title" content="@PageTitle" />
        <meta name="description" content="@PageDescription" />
        <script>
            (() => {
                const stored = localStorage.getItem("theme");
                const preferred = stored ?? (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
                document.documentElement.dataset.theme = preferred;
            })();
        </script>
        @foreach (var css in Theme!.Stylesheets)
        {
            <link rel="stylesheet" href="@GetThemeUrl(css)" />
        }
    </head>
    <body>
        <header class="site-header">
            <a class="site-title" href=".">@Site.Title</a>
            <nav aria-label="Primary navigation">
                <ul class="navigation-list">
                    <li><a href=".">Home</a></li>
                    <li><a href="tags">Tags</a></li>
                    @RenderNavigation(string.Empty)
                </ul>
                <button id="theme-toggle" type="button" aria-label="Switch color theme" title="Switch color theme">
                    <svg class="theme-icon moon-icon" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
                    </svg>
                    <svg class="theme-icon sun-icon" viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="12" cy="12" r="4"></circle>
                        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
                    </svg>
                </button>
            </nav>
        </header>

        <main>
            @Body
        </main>

        <footer class="site-footer">
            <small>Powered by <a href="https://github.com/getscissorhands/ScissorHands.NET">ScissorHands.NET</a></small>
            <small>Default theme adapted from <a href="https://github.com/ChurchTao/PlainPage">PlainPage</a>.</small>
            @if (!string.IsNullOrWhiteSpace(Site.Author))
            {
                <small>&copy; @DateTimeOffset.UtcNow.Year @Site.Author</small>
            }
        </footer>

        @foreach (var script in Theme.Scripts)
        {
            <script src="@GetThemeUrl(script)"></script>
        }
    </body>
    </html>
</CascadingMainLayoutBase>

@code {
    private ILookup<string, NavigationItem> _navigation = Array.Empty<NavigationItem>().ToLookup(item => item.Path);

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        var items = new Dictionary<string, NavigationItem>(StringComparer.Ordinal);
        foreach (var pageDocument in NavigationPages)
        {
            var path = GetContentUrl(pageDocument.Metadata.Slug);
            items.Add(path, new NavigationItem(pageDocument.Metadata.Title, path, path, string.Empty));
        }

        foreach (var path in items.Keys.ToArray())
        {
            var parentPath = GetParentPath(path);
            while (parentPath.Length > 0)
            {
                var segment = Uri.UnescapeDataString(parentPath[(parentPath.LastIndexOf('/') + 1)..]);
                var title = CultureInfo.InvariantCulture.TextInfo.ToTitleCase(segment.Replace('-', ' ').Replace('_', ' '));
                items.TryAdd(parentPath, new NavigationItem(title, parentPath, null, string.Empty));
                parentPath = GetParentPath(parentPath);
            }
        }

        // A locale routing prefix is not a content group unless it has its own visible page.
        if (Site?.UseLocaleInUrl == true)
        {
            foreach (var pageDocument in NavigationPages)
            {
                var locale = string.IsNullOrWhiteSpace(pageDocument.Metadata.Locale) ? Site.Locale : pageDocument.Metadata.Locale;
                if (string.IsNullOrWhiteSpace(locale))
                {
                    continue;
                }

                var localePath = GetContentUrl(locale.Trim().Replace('_', '-').Replace('/', '-').ToLowerInvariant());
                if (items.TryGetValue(localePath, out var item) && item.Url is null)
                {
                    items.Remove(localePath);
                }
            }
        }

        _navigation = items.Values
            .OrderBy(item => item.Title, StringComparer.Ordinal)
            .ThenBy(item => item.Path, StringComparer.Ordinal)
            .Select((item, index) => item with { SubmenuId = $"navigation-submenu-{index}" })
            .ToLookup(item =>
            {
                var parentPath = GetParentPath(item.Path);
                return items.ContainsKey(parentPath) ? parentPath : string.Empty;
            }, StringComparer.Ordinal);
    }

    private static string GetParentPath(string path)
    {
        var separator = path.LastIndexOf('/');
        return separator < 0 ? string.Empty : path[..separator];
    }

    private RenderFragment RenderNavigation(string parentUrl) => @<text>
        @foreach (var item in _navigation[parentUrl])
        {
            var hasChildren = _navigation[item.Path].Any();
            <li class="navigation-item">
                <div class="navigation-link">
                    @if (item.Url is not null)
                    {
                        <a href="@item.Url">@item.Title</a>
                    }
                    else
                    {
                        <span class="navigation-label">@item.Title</span>
                    }
                    @if (hasChildren)
                    {
                        <button class="navigation-toggle" type="button" aria-expanded="false" aria-controls="@item.SubmenuId" aria-label="@($"Toggle {item.Title} pages")" hidden>
                            <svg viewBox="0 0 16 16" aria-hidden="true">
                                <path d="m4 6 4 4 4-4"></path>
                            </svg>
                        </button>
                    }
                </div>
                @if (hasChildren)
                {
                    <ul class="navigation-children" id="@item.SubmenuId">
                        @RenderNavigation(item.Path)
                    </ul>
                }
            </li>
        }
    </text>;

    private sealed record NavigationItem(string Title, string Path, string? Url, string SubmenuId);
}
