@inherits ScissorHands.Theme.PostViewBase
@layout MainLayout

<section class="post">
    <a class="back-link" href=".">&larr; Back to posts</a>
    <article class="prose">
        @if (!string.IsNullOrWhiteSpace(Document?.Metadata.HeroImage))
        {
            <img class="hero-image" src="@ContentUrl(Document.Metadata.HeroImage)" alt="" />
        }

        @if (Document?.Metadata.Published is not null)
        {
            <header class="post-header">
                <time datetime="@Document.Metadata.Published.Value.ToString("O")">
                    @Document.Metadata.Published.Value.ToString("D")
                </time>
            </header>
        }

        @((MarkupString)Document?.Html!)

        @if (Document?.Metadata.Tags.Any() == true)
        {
            <ul class="tag-list" aria-label="Post tags">
                @foreach (var tag in Document.Metadata.Tags)
                {
                    <li><a href="tags/@Uri.EscapeDataString(tag.ToLowerInvariant())">#@tag</a></li>
                }
            </ul>
        }
    </article>
</section>

@code {
    private static string ContentUrl(string path) => path.TrimStart('/');
}
