@inherits ScissorHands.Theme.IndexViewBase
@layout MainLayout

<section class="home">
    <article>
        @if (Documents?.Any() != true)
        {
            <p>Welcome aboard ScissorHands.NET!</p>
        }
        else
        {
            @foreach (var post in Documents!)
        {
            <article>
                <div>
                    <a href="/@post.Metadata.Slug">@post.Metadata.Title</a>
                </div>
                @if (string.IsNullOrWhiteSpace(post.Metadata.Description) == false)
                {
                    <div>
                        <p>@post.Metadata.Description</p>
                    </div>
                }
            </article>
            }
        }
    </article>
</section>
