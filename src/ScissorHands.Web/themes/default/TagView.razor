@inherits ScissorHands.Theme.TagViewBase
@layout MainLayout

<section class="tag prose">
    <a class="back-link" href="tags">&larr; All tags</a>
    <h1>#@Tag</h1>
    @if ((TaggedPosts?.Any() != true) && (TaggedPages?.Any() != true))
    {
        <p>No content found for this tag.</p>
    }
    else
    {
        @if (TaggedPosts?.Any() == true)
        {
            <h2>Posts</h2>
            <ul class="post-list">
                @foreach (var post in TaggedPosts)
                {
                    <li>
                        <time datetime="@post.Metadata.Published?.ToString("O")">
                            @(post.Metadata.Published?.ToString("yyyy-MM-dd") ?? "Undated")
                        </time>
                        <div><a class="post-link" href="@post.Metadata.Slug">@post.Metadata.Title</a></div>
                    </li>
                }
            </ul>
        }
        @if (TaggedPages?.Any() == true)
        {
            <h2>Pages</h2>
            <ul class="page-list">
                @foreach (var pageDocument in TaggedPages)
                {
                    <li><a href="@pageDocument.Metadata.Slug">@pageDocument.Metadata.Title</a></li>
                }
            </ul>
        }
    }
</section>
