@inherits ScissorHands.Theme.TagListViewBase
@layout MainLayout

<section class="tags prose">
    <h1>Tags</h1>
    <p>Browse all topics used across published content.</p>
    @if (TaggedDocuments?.Any() != true)
    {
        <p>No tags found.</p>
    }
    else
    {
        <div class="tag-grid">
            @foreach (var tagEntry in TaggedDocuments!.OrderBy(t => t.Key))
            {
                var count = tagEntry.Value.Posts.Count() + tagEntry.Value.Pages.Count();
                <a class="tag-card" href="tags/@Uri.EscapeDataString(tagEntry.Key.ToLowerInvariant())">
                    <span>#@tagEntry.Key</span>
                    <small>@count @(count == 1 ? "item" : "items")</small>
                </a>
            }
        </div>
    }
</section>
