<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <LangVersion>latest</LangVersion>
    <RazorLangVersion>latest</RazorLangVersion>

    <AssemblyName>ScissorHands.Site</AssemblyName>
    <RootNamespace>ScissorHands.Site</RootNamespace>

    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="contents/**/*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="themes/**/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ScissorHands.Web\ScissorHands.Web.csproj" />
  </ItemGroup>
</Project>
