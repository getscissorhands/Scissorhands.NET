@inherits ScissorHands.Theme.IndexViewBase
@layout MainLayout

<section class="home">
    <header class="home__hero">
        <p class="home__eyebrow">ScissorHands</p>
        <h1 class="home__title">@Site!.Title</h1>
        <p class="home__subtitle">A Blazor-powered static blog with live preview.</p>
    </header>
    <div class="home__list">
        @foreach (var post in Documents)
        {
            <article class="home__card">
                <a class="home__link" href="/@post.Metadata.Slug/">
                    <div class="home__card-meta">
                        @if (post.Metadata.Published is { } published)
                        {
                            <span>@published.ToString("MMMM dd, yyyy")</span>
                        }
                    </div>
                    <h2 class="home__card-title">@post.Metadata.Title</h2>
                    @if (!string.IsNullOrWhiteSpace(post.Metadata.Description))
                    {
                        <p class="home__card-desc">@post.Metadata.Description</p>
                    }
                    @if (post.Metadata.Tags.Any())
                    {
                        <ul class="home__card-tags">
                            @foreach (var tag in post.Metadata.Tags)
                            {
                                <li>@tag</li>
                            }
                        </ul>
                    }
                </a>
            </article>
        }
    </div>
</section>
